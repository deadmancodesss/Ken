# Copy to .env and fill in. .env is gitignored, so never commit real keys.

# ---- Walrus Memory (Mainnet) -------------------------------------------------
# Create at https://memory.walrus.xyz/dashboard
# Delegate private key (suiprivkey1... or hex). Rotate before any public launch.
MEMWAL_KEY=
# The Walrus Memory account ID shown at the top of the dashboard.
# Note: this is the account object, NOT your wallet address.
MEMWAL_ACCOUNT_ID=
# Public half of the delegate key, listed under "Delegate keys".
MEMWAL_AGENT_ID=
# Writes are scoped per account + namespace so test junk never mixes with app data.
MEMWAL_NAMESPACE=plumbing
# Mainnet relayer. Testnet is a different account and memories do not migrate.
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# ---- Tatum Sui gateway -------------------------------------------------------
# Sui is exposed as GraphQL only here; JSON-RPC POSTs to the gateway 404.
# Free tier is ~5 requests/minute, so every read path batches.
TATUM_API_KEY=
TATUM_SUI_GRAPHQL_URL=https://sui-mainnet.gateway.tatum.io/graphql
TATUM_API_KEY_TESTNET=
TATUM_SUI_GRAPHQL_URL_TESTNET=https://sui-testnet.gateway.tatum.io/graphql

# ---- Agent wallet ------------------------------------------------------------
# Server-side only, generated locally and funded from the testnet faucet. It signs
# nothing for a connected person: their own wallet signs and pays.
AGENT_ADDRESS=
AGENT_SECRET_KEY=

# ---- NVIDIA NIM (fallback brain) ---------------------------------------------
# Free tier is metered by requests per minute rather than by tokens. The gateway is
# OpenAI compatible, so the whole tool loop runs here unchanged. Get a key at
# https://build.nvidia.com. Warning measured on 2026-11-03: /v1/models answers 200 even
# for a junk key, while /v1/chat/completions answers 403 Authorization failed, so test
# an inference call before believing a key works.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# A comma separated chain on the same key, tried in order. Measured against the real tool
# schemas with thinking off. On the 24 probe sweep the 4B Bolt sent 24 of 24 to the right
# tool at a 986 ms median and the 550B Ultra sent 20 of 24. On the nine probes the build
# ships, Ultra sent 6 of 6 and called remember_this both times, while Bolt answered
# "remember that" in words and never called the tool in three runs. Recall is the product,
# so Ultra is the first NVIDIA name and the faster Bolt follows. The 30B Lightning answered
# people_you_know to half the prompts and the 120B Super VL sent 19 of 24 but neither is in
# this chain. Gemini answers first and the two lanes are alternated by depth, so Ultra is
# the second attempt on the whole chain, ahead of Gemini's second name.
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-bolt-e4b
# Nemotron reasons by default and a voice turn has no seconds to spare. Setting this to
# 1 turns thinking back on for a batch test. Measured on the nine shipped probes: thinking
# on was a 2.8 s median with a 6.8 s tail, thinking off was a 1.2 s median with a 1.9 s
# tail, and the tool and spoken scores were identical. Models that do not reason ignore it.
NVIDIA_THINKING=0
# A route that refuses its key is skipped for this long instead of being re-asked on
# every turn. A minute recovers inside one conversation and still costs a dead key one request
# a minute rather than one a turn.
# ROUTE_COOLDOWN_MS=60000

# ---- Gemini direct (primary brain) -------------------------------------------
# The first lane: one OpenAI-compatible path to Gemini. Key from
# https://aistudio.google.com/apikey
MODEL_API_KEY=
MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# A comma separated chain, tried in order on the same key. A free tier answers 503
# "high demand" and 429 without warning, and a live conversation must not stop on that. On the nine
# shipped probes on 2026-11-04, flash lite sent 6 of 6 tool calls and 3 of 3 spoken
# answers at a 3.4 s median with an 11.6 s tail. That is slower than the NVIDIA fallback,
# so a long tail still spends the timeout and lands on the next name.
MODEL_NAME=gemini-3.1-flash-lite,gemini-3.5-flash

# ---- OpenRouter (voice only) -------------------------------------------------
# The brain no longer uses OpenRouter. On 2026-11-03 its free requests read 52 used of
# 50, every free name answered 429 within 200 ms, and the paid names were refused with
# a 402 about credit. It stays because HeyGen is the only voice OpenRouter carries, and
# speech.ts reads this key for that. Make one at https://openrouter.ai/settings/keys.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# The most a single reply may spend. A reasoning model allowed to think for thousands of
# tokens returns an empty message inside a voice turn, and a model allowed to write for
# thousands returns a paragraph nobody asked to hear. A spoken answer is a few sentences.
MODEL_MAX_TOKENS=600
# A model that thinks for three minutes is a dead conversation, so the attempt is cut and
# the next name is asked. Set 0 to wait as long as the provider likes.
MODEL_TIMEOUT_MS=25000

# ---- TypeSafe ----------------------------------------------------------------
# Jev, the decision model. Its console key begins apikey_ and is a real API key, which
# this repo once mistook for a browser session token and threw away. Nothing reads it
# now. TypeSafe serves only its own /v1/systemone shape, which answers which tool fits
# and cannot produce the arguments for it, and it has no OpenAI compatible
# /chat/completions at all. OpenRouter's typesafe/jev-router is gone with the rest of
# that route. This key is kept here so a direct route has somewhere to live if that
# integration is ever built.
TYPESAFE_API_KEY=

# ---- Voice -------------------------------------------------------------------
# Three vendors answer for the agent's voice and all are optional. Fish is tried first
# because its free tier is capped at five requests at once rather than at a number of
# sentences nobody has published, and because the allowance it spends is its own rather
# than the fifty a day OpenRouter shares with the brain. Measured 2026-11-03 on one
# spoken sentence: 2.1 s from HeyGen, 3.4 from Fish Audio, 4.8 from Gemini. So Fish is
# the second quickest mouth and the one that never competes with the model for requests.
# With no key at all the pages use this browser's own voice and say so.
# Reorder them with VOICE_ORDER=fish,openrouter,gemini.
# Free is chosen by a request header inside the code, not by this key, so a Fish key
# always spends zero credits. The community voice ids in FISH_VOICES are cloned voices
# from Fish's marketplace, so each one is your own licensing decision and none ship by
# default. Format is id:Label, comma separated.
# FISH_API_KEY=
# FISH_VOICES=
# HeyGen is the only voice OpenRouter carries, and it is worth knowing how to find it,
# because it is not in their model list at all and looks fictional until you call it. It
# answers 400 to wav and mp3 and returns raw pcm at 44.1 kHz, and the sample rate is read
# off the reply rather than assumed. Its free tier spends one of the fifty requests a day
# that the brain also wants, which is why it sits behind Fish. There is no Fish model on
# this route. Asking for fish/s2.1-pro-free is answered "does not exist", so a middleman
# cannot be used to reach the first vendor.
# OPENROUTER_TTS_MODEL=heygen/heygen-voice-1-turbo:free
# TTS_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# TTS_MODEL=gemini-3.8-flash-tts
# TTS_VOICE=Kore
# A vendor that just failed is skipped for this long, so a spent quota costs one wasted
# request per sentence rather than one every time. Set 0 to retry on every sentence.
# VOICE_COOLDOWN_MS=60000

# ---- Live call ---------------------------------------------------------------
# Two-way audio on one socket. Needs MODEL_API_KEY or GEMINI_API_KEY, and nothing else,
# because the browser posts microphone bytes to this server and never holds a key.
# Unset, or set to a model that is not an audio model, and /call falls back to one turn
# at a time. A comma separated chain is tried in order, and 3.8 sits behind 3.1 because
# Google has published 2026-11-17 as the earliest shutdown for 3.1.
LIVE_MODEL=gemini-3.1-flash-live-preview,gemini-3.8-live
# LIVE_API_KEY=

# ---- Payments ----------------------------------------------------------------
# Nothing moves on chain unless this is 1. Off by default so a stray
# `npm run tools -- pay_usdc` can never spend.
PAY_ENABLED=0
# One switch decides which ledger money moves on, and it is mainnet unless this says
# testnet. It sets the USDC package, the gateway the payment path reads, the x402 terms,
# the paid index prices and every explorer link, so no file pins the build to a network.
# A testnet run sets PAY_NETWORK=testnet because the agent wallet holds no
# mainnet funds, and the agent refuses to sign a real-money payment nobody approved.
PAY_NETWORK=mainnet
# Hard ceiling per payment, in base units (USDC has 6 decimals, so 5000000 = 5 USDC).
PAY_MAX_BASE_UNITS=5000000
# Optional relay for the payment path only. Unset, it follows PAY_NETWORK.
PAY_GRAPHQL_URL=
PAY_GRAPHQL_KEY=

# ---- x402: the paid index ----------------------------------------------------
# The seller is its own process (`npm run sell`) on its own port, with its own ledger
# and no signing key. The agent is the buyer and never calls the seller's code.
# Start the seller before the agent or a paid lookup will say the index is not answering.
SELLER_HOST=127.0.0.1
SELLER_PORT=8788
# Full 0x Sui address that receives the sale, on the network PAY_NETWORK names. It must
# not be the wallet that is buying: a self deal moves no money and is refused.
SELLER_WALLET=
# One price for a profile or a receipt check, and the busy price for a wallet whose
# history is longer than SELLER_BUSY_TXS transactions, because a longer history costs
# the seller more Tatum reads. The reason is published in the 402 reply.
SELLER_PRICE_USDC=0.01
SELLER_BUSY_PRICE_USDC=0.03
SELLER_BUSY_TXS=20
# The seller's own sale ledger. Never shared with the buyer's `.paid.json`.
# SELLER_LEDGER=.seller.json

# Where the buyer asks for a price. This must point at the seller process, not the app.
PAID_SOURCE_URL=http://127.0.0.1:8788/paid
# The most the buyer will pay for one fact. A higher quote is refused, not paid. The
# default sits between the base price and the busy price, so a busy quote is refused
# until this is raised on purpose.
PAID_MAX_USDC=0.02

# The self-hosted facilitator's replay store, so the same signed envelope cannot settle
# twice. It holds no key and only broadcasts bytes the payer signed.
# FACILITATOR_STORE=.facilitator.json
# FACILITATOR_REMEMBER=2000

# ---- Cold start persistence (Litestream + Cloudflare R2) ----------------------
# The Docker image restores every SQLite store from R2 before the app opens it, then
# streams changes back, because a Render free service starts each cold boot with an
# empty disk. `npm start` does not use any of this and reads the local data/ folder.
# R2_ENDPOINT is https://<account-id>.r2.cloudflarestorage.com and carries no bucket.
# The token is scoped to Object Read and Write on the single ken-db bucket named in
# tools/litestream.yml. These are read by the Litestream binary, not by the app.
R2_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
