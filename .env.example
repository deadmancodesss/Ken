# Copy to .env and fill in. .env is gitignored, so never commit real keys.

# ---- Walrus Memory (Mainnet) -------------------------------------------------
# Create at https://memory.walrus.xyz/dashboard
# Delegate private key (suiprivkey1... or hex). Rotate before any public demo.
MEMWAL_KEY=
# The Walrus Memory account ID shown at the top of the dashboard.
# Note: this is the account object, NOT your wallet address.
MEMWAL_ACCOUNT_ID=
# Public half of the delegate key, listed under "Delegate keys".
MEMWAL_AGENT_ID=
# Writes are scoped per account + namespace so test junk never mixes with app data.
MEMWAL_NAMESPACE=plumbing
# Mainnet relayer. Testnet is a different account and memories do not migrate.
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# ---- Tatum Sui gateway -------------------------------------------------------
# Sui is exposed as GraphQL only here; JSON-RPC POSTs to the gateway 404.
# Free tier is ~5 requests/minute, so every read path batches.
TATUM_API_KEY=
TATUM_SUI_GRAPHQL_URL=https://sui-mainnet.gateway.tatum.io/graphql
TATUM_API_KEY_TESTNET=
TATUM_SUI_GRAPHQL_URL_TESTNET=https://sui-testnet.gateway.tatum.io/graphql

# ---- Demo agent wallet (testnet only) ----------------------------------------
# Generated locally. Holds no mainnet value. Funded by the public PoW faucet.
AGENT_ADDRESS=
AGENT_SECRET_KEY=
# The wallet the agent narrates. Defaults to AGENT_ADDRESS when unset.
DEMO_WALLET=
DEMO_WALLET_NETWORK=testnet

# ---- Model -------------------------------------------------------------------
# One OpenAI-compatible path, so any of Gemini / OpenRouter / OpenAI works.
# Gemini key from https://aistudio.google.com/apikey
MODEL_API_KEY=
MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# A comma separated chain, tried in order on the same key. A free tier answers 503
# "high demand" and 429 without warning, and a demo must not stop on that.
MODEL_NAME=gemini-3.1-flash-lite,gemini-3.5-flash

# ---- OpenRouter --------------------------------------------------------------
# When this key exists, OpenRouter is asked before Gemini and Gemini becomes the
# fallback. A value starting apikey_ is a browser session token and is reported rather
# than sent, because every route was measured refusing it. Make a real key at
# https://openrouter.ai/settings/keys. It begins sk-or-v1-.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# The lane that speaks the answer. These three are ranked for a spoken turn: Lightning is
# 3B active parameters and answers in about a second, Gemma 4 31B is the dense fallback,
# and Nemotron Ultra is 55B active, which is the most capable free name and also the
# slowest thing that could answer mid sentence. npm run textbench is how to change them.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
# The lane that chooses a tool, which is a classification rather than a sentence. Jev
# Router picks a model and a reasoning effort per request and prices at whatever it
# chose, so a zero credit account is refused 402 and Free Models Router behind it costs
# nothing. Both are routers, so the pages name the model that actually served rather
# than the router.
DECISION_MODEL=typesafe/jev-router,openrouter/free
# A model that thinks for three minutes is a dead conversation, so the attempt is cut and
# the next name is asked. Set 0 to wait as long as the provider likes.
MODEL_TIMEOUT_MS=120000

# ---- Voice -------------------------------------------------------------------
# Three vendors answer for the agent's voice and all are optional. Fish is tried first
# because it measured around two seconds a sentence against Gemini's five, and because
# its free tier is capped at five requests at once rather than at a number of sentences
# nobody has published. HeyGen comes through OpenRouter. Gemini covers any sentence the
# others refuse. With no key at all the pages use this browser's own voice and say so.
# Reorder them with VOICE_ORDER=fish,openrouter,gemini.
# Free is chosen by a request header inside the code, not by this key, so a Fish key
# always spends zero credits. The community voice ids in FISH_VOICES are cloned voices
# from Fish's marketplace, so each one is your own licensing decision and none ship by
# default. Format is id:Label, comma separated.
# FISH_API_KEY=
# FISH_VOICES=
# HeyGen is the only new voice OpenRouter offers. Its free tier spends one of the fifty
# requests a day that the brain also wants, which is why it sits behind Fish. OpenRouter
# also lists a free Fish model, and that one is deliberately not wired: it is the same
# s2.1-pro-free already called direct, described by the catalogue as without production
# latency, so routing it through a middleman would cost a request to get a worse answer.
# OPENROUTER_TTS_MODEL=heygen/heygen-voice-1-turbo:free
# TTS_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# TTS_MODEL=gemini-3.8-flash-tts
# TTS_VOICE=Kore
# A vendor that just failed is skipped for this long, so a spent quota costs one wasted
# request per sentence rather than one every time. Set 0 to retry on every sentence.
# VOICE_COOLDOWN_MS=60000

# ---- Live call ---------------------------------------------------------------
# Two-way audio on one socket. Needs MODEL_API_KEY or GEMINI_API_KEY, and nothing else,
# because the browser posts microphone bytes to this server and never holds a key.
# Unset, or set to a model that is not an audio model, and /call falls back to one turn
# at a time. A comma separated chain is tried in order, and 3.8 sits behind 3.1 because
# Google has published 2026-11-17 as the earliest shutdown for 3.1.
LIVE_MODEL=gemini-3.1-flash-live-preview,gemini-3.8-live
# LIVE_API_KEY=

# ---- Payments ----------------------------------------------------------------
# Nothing moves on chain unless this is 1. Off by default so a stray
# `npm run tools -- pay_usdc` can never spend.
PAY_ENABLED=0
# Hard ceiling per payment, in base units (USDC has 6 decimals, so 5000000 = 5 USDC).
PAY_MAX_BASE_UNITS=5000000

# The paid address index in src/x402.ts. Where its lookups are sold and where the money goes.
PAID_SOURCE_URL=http://127.0.0.1:8787/paid
PAID_PRICE_USDC=0.01
SELLER_WALLET=
